{
  "welcome_rules": {
    "type": "template_list",
    "description": "入群欢迎规则",
    "hint": "由插件页面的运行配置管理，可配置多条并按群生效。",
    "default": [],
    "invisible": true,
    "templates": {
      "welcome_rule": {
        "name": "入群欢迎",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "规则名称",
            "default": "入群欢迎"
          },
          "message": {
            "type": "text",
            "description": "欢迎内容",
            "default": "欢迎 {at_user} 加入 {group_name}"
          },
          "group_openids": {
            "type": "list",
            "description": "覆盖群 OpenID",
            "default": []
          },
          "enabled": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "at_member": {
            "type": "bool",
            "description": "艾特新成员",
            "default": true
          },
          "auto_recall_seconds": {
            "type": "int",
            "description": "自动撤回（秒）",
            "default": 0,
            "slider": {"min": 0, "max": 120, "step": 5}
          }
        }
      }
    }
  },
