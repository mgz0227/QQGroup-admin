{
  "uid_review_interval_seconds": {
    "type": "int",
    "description": "条件审核轮询间隔（秒）",
    "hint": "15-600 秒。多个群会自动错峰处理，建议保留 60 秒。",
    "default": 60,
    "slider": {
      "min": 15,
      "max": 600,
      "step": 15
    }
  },
  "mute_success_message": {
    "type": "string",
    "description": "禁言成功回复",
    "hint": "支持 {duration}、{expire_at}、{member_openid} 占位符。",
    "default": "已设置禁言，至 {expire_at}。"
  },
  "mute_reply_at_member": {
    "type": "bool",
    "description": "禁言成功后 @成员",
    "hint": "启用后在成功回复开头提及被禁言成员。",
    "default": false
  },
  "auto_review_groups": {
    "type": "template_list",
    "description": "QQ群自动审核配置",
    "hint": "优先在目标群发送 /审核设置 并点击绑定，群名称和 OpenID 会自动写入。",
    "default": [],
    "templates": {
      "qq_group": {
        "name": "群",
        "display_item": "group_name",
        "hide_hint_in_list": true,
        "items": {
          "group_name": {
            "type": "string",
            "description": "群名称",
            "hint": "群内绑定时由 QQ 官方接口自动读取。",
            "default": ""
          },
          "group_openid": {
            "type": "string",
            "description": "群 OpenID",
            "hint": "不是 QQ 群号。请在目标群发送 /群信息 获取。",
            "default": ""
          },
          "enabled": {
            "type": "bool",
            "description": "启用 QQ 号码白名单",
            "hint": "与条件审核二选一。关闭后同步会删除该群的 QQ 官方策略。",
            "default": false
          },
          "whitelist_qq_numbers": {
            "type": "text",
            "description": "白名单 QQ 号码",
            "hint": "支持逗号、空格或换行分隔，最多 100000 个。同步会增删与上次配置的差异。",
            "default": ""
          },
          "scan_pending": {
            "type": "bool",
            "description": "同步后扫描待审申请",
            "hint": "启用后调用 QQ 官方执行接口，预计约 10 分钟完成。",
            "default": true
          },
          "uid_review_enabled": {
            "type": "bool",
            "description": "启用条件审核",
            "hint": "拒绝关键词优先，其余启用条件可按全部满足或任一满足组合。",
            "default": false
          },
          "uid_check_enabled": {
            "type": "bool",
            "description": "检查 B 站 UID",
            "hint": "验证消息需为纯数字，或包含 UID:数字。B 站查询异常时保留待审。",
            "default": true
          },
          "approve_keywords": {
            "type": "text",
            "description": "通过关键词",
            "hint": "逗号、分号或换行分隔，最多 100 个。命中任意一个即满足关键词条件。",
            "default": ""
          },
          "reject_keywords": {
            "type": "text",
            "description": "硬拒绝关键词",
            "hint": "命中后立即拒绝，优先于 UID、通过关键词、与或组合和兜底规则。",
            "default": ""
          },
          "condition_logic": {
            "type": "string",
            "description": "条件组合",
            "hint": "全部满足为 AND，任一满足为 OR。",
            "default": "all",
            "options": ["all", "any"],
            "labels": ["全部满足", "任一满足"]
          },
          "fallback_action": {
            "type": "string",
            "description": "条件未通过时",
            "hint": "B 站查询异常始终保留待审，不执行兜底。",
            "default": "pending",
            "options": ["pending", "decline", "approve"],
            "labels": ["保留待审", "拒绝申请", "同意申请"]
          },
          "button_reject_reason": {
            "type": "string",
            "description": "按钮拒绝理由",
            "hint": "管理员点击拒绝按钮时提交给 QQ；留空时使用“管理员拒绝”。",
            "default": "管理员拒绝"
          },
          "platform_id": {
            "type": "string",
            "default": "",
            "invisible": true
          },
          "managed_strategy_id": {
            "type": "string",
            "default": "",
            "invisible": true
          },
          "applied_whitelist": {
            "type": "text",
            "default": "",
            "invisible": true
          }
        }
      }
    }
  }
}
